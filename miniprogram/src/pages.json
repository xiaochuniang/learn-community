{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationBarTitleText": "学习地图",
        "navigationStyle": "custom",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/course/index",
      "style": {
        "navigationBarTitleText": "课程",
        "navigationBarBackgroundColor": "#3b82f6",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/message/index",
      "style": {
        "navigationBarTitleText": "消息",
        "navigationBarBackgroundColor": "#3b82f6",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "我的",
        "navigationBarBackgroundColor": "#3b82f6",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/auth/index",
      "style": {
        "navigationBarTitleText": "",
        "navigationStyle": "custom"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages/map",
      "pages": [
        {
          "path": "library",
          "style": {
            "navigationBarTitleText": "图书馆",
            "navigationBarBackgroundColor": "#1b5e20",
            "navigationBarTextStyle": "white",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "creative",
          "style": {
            "navigationBarTitleText": "文创店",
            "navigationBarBackgroundColor": "#1b5e20",
            "navigationBarTextStyle": "white",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "stationery",
          "style": {
            "navigationBarTitleText": "文具店",
            "navigationBarBackgroundColor": "#1b5e20",
            "navigationBarTextStyle": "white",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "bookstore",
          "style": {
            "navigationBarTitleText": "书店",
            "navigationBarBackgroundColor": "#1b5e20",
            "navigationBarTextStyle": "white",
            "navigationStyle": "custom"
          }
        },
        {
          "path": "club",
          "style": {
            "navigationBarTitleText": "社团",
            "navigationBarBackgroundColor": "#1b5e20",
            "navigationBarTextStyle": "white",
            "navigationStyle": "custom"
          }
        }
      ]
    },
    {
      "root": "pages/course-detail",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "课程详情",
            "navigationBarBackgroundColor": "#3b82f6",
            "navigationBarTextStyle": "white"
          }
        }
      ]
    },
    {
      "root": "pages/tutor",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "陪伴师",
            "navigationBarBackgroundColor": "#3b82f6",
            "navigationBarTextStyle": "white"
          }
        },
        {
          "path": "detail",
          "style": {
            "navigationBarTitleText": "陪伴师详情",
            "navigationBarBackgroundColor": "#3b82f6",
            "navigationBarTextStyle": "white"
          }
        },
        {
          "path": "apply",
          "style": {
            "navigationBarTitleText": "成为陪伴师",
            "navigationBarBackgroundColor": "#3b82f6",
            "navigationBarTextStyle": "white",
            "enablePullDownRefresh": false
          }
        }
      ]
    },
    {
      "root": "pages/order",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "我的订单",
            "navigationBarBackgroundColor": "#3b82f6",
            "navigationBarTextStyle": "white"
          }
        },
        {
          "path": "detail",
          "style": {
            "navigationBarTitleText": "订单详情",
            "navigationBarBackgroundColor": "#3b82f6",
            "navigationBarTextStyle": "white"
          }
        }
      ]
    }
  ],
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#3b82f6",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/course/index",
        "text": "课程",
        "iconPath": "static/tabbar/course.png",
        "selectedIconPath": "static/tabbar/course-active.png"
      },
      {
        "pagePath": "pages/message/index",
        "text": "消息",
        "iconPath": "static/tabbar/message.png",
        "selectedIconPath": "static/tabbar/message-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "static/tabbar/profile.png",
        "selectedIconPath": "static/tabbar/profile-active.png"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "学习社区",
    "navigationBarBackgroundColor": "#3b82f6",
    "backgroundColor": "#f4f6f8",
    "backgroundTextStyle": "light"
  },
  "uniIdRouter": {}
}